generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  gpUserId     String?
  userName     String?
  firstName    String
  lastName     String?
  email        String   @unique
  phone        String?
  avatar       String?
  refreshToken String?
  isVerified   Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  password     String   @unique

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isVerified])
  @@index([isAdmin])
  @@index([userName])
  @@index([createdAt])
}

model Category {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String        @unique
  heading     Json          @default("{}")
  description Json          @default("{}")
  subCategory SubCategory[]
  persons     Person[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model SubCategory {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  categoryId String?    @db.ObjectId
  category   Category?  @relation(fields: [categoryId], references: [id])
  persons    Person[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([categoryId, name])
  @@index([createdAt])
}

model Gotr {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameHi    String
  nameEn    String
  isApproved Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved])
  @@index([nameEn])
  @@index([nameHi])
  @@index([isApproved, nameEn])
  @@index([isApproved, nameHi])
  @@index([createdAt])
}

model Person {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  nameHi       String
  nameEn       String
  description  Json?
  imageUrl     String?

  categoryId   String     @db.ObjectId
  category     Category   @relation(fields: [categoryId], references: [id])

  subCategoryId String?     @db.ObjectId
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  // category-specific fields
  award      String?   // for Award category
  cadre      String?   // for Services
  post       String?   // for Politicians
  sport      String?   // for Sports
  profession String?   // for Artists

  order       Int       @default(0)
  isApproved  Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isApproved])
  @@index([order])
  @@index([createdAt])
  @@index([categoryId, isApproved])
  @@index([subCategoryId, isApproved])
  @@index([isApproved, createdAt])
  @@index([categoryId, isApproved, order])
  @@index([subCategoryId, isApproved, order])
  @@index([nameEn])
  @@index([nameHi])
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}